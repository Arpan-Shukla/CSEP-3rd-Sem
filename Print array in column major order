#include <iostream>
using namespace std;

int main()
{
    int rows, cols;

    cout << "Enter number of rows: ";
    cin >> rows;

    cout << "Enter number of columns: ";
    cin >> cols;

    int arr[rows][cols];

    cout << "Enter array elements: ";
    for(int i = 0; i < rows; i++)
    {
        for(int j = 0; j < cols; j++)
        {
            cin >> arr[i][j];
        }
    }

    cout << "Column major order: ";

    for(int j = 0; j < cols; j++)
    {
        for(int i = 0; i < rows; i++)
        {
            cout << arr[i][j] << " ";
        }
    }

    return 0;
}
