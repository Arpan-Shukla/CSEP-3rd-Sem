#include <iostream>
using namespace std;

int main()
{
    int n;

    cout << "Enter size of array: ";
    cin >> n;

    int arr[n];

    cout << "Enter elements: ";
    for(int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    int count = 0;

    for(int i = 0; i < n; i++)
    {
        if(arr[i] > arr[(i + 1) % n])
        {
            count++;
        }
    }

    if(count <= 1)
    {
        cout << "Array is sorted and rotated";
    }
    else
    {
        cout << "Array is not sorted and rotated";
    }

    return 0;
}
