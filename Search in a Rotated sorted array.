#include <iostream>
using namespace std;

int main()
{
    int n, key;

    cout << "Enter size of array: ";
    cin >> n;

    int arr[n];

    cout << "Enter rotated sorted array elements: ";
    for(int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    cout << "Enter element to search: ";
    cin >> key;

    int low = 0, high = n - 1;
    int ans = -1;

    while(low <= high)
    {
        int mid = low + (high - low) / 2;

        if(arr[mid] == key)
        {
            ans = mid;
            break;
        }

        if(arr[low] <= arr[mid])
        {
            if(arr[low] <= key && key < arr[mid])
                high = mid - 1;
            else
                low = mid + 1;
        }
        else
        {
            if(arr[mid] < key && key <= arr[high])
                low = mid + 1;
            else
                high = mid - 1;
        }
    }

    if(ans != -1)
        cout << "Element found at index " << ans;
    else
        cout << "Element not found";

    return 0;
}
