#include <iostream>
using namespace std;

int main()
{
    int n;

    cout << "Enter size of square matrix: ";
    cin >> n;

    int arr[n][n];

    cout << "Enter matrix elements: ";
    for(int i = 0; i < n; i++)
    {
        for(int j = 0; j < n; j++)
        {
            cin >> arr[i][j];
        }
    }

    int primarySum = 0, secondarySum = 0;

    for(int i = 0; i < n; i++)
    {
        primarySum += arr[i][i];
        secondarySum += arr[i][n - i - 1];
    }

    if(primarySum >= secondarySum)
    {
        cout << "Diagonal with maximum value: ";
        for(int i = 0; i < n; i++)
        {
            cout << arr[i][i] << " ";
        }
    }
    else
    {
        cout << "Diagonal with maximum value: ";
        for(int i = 0; i < n; i++)
        {
            cout << arr[i][n - i - 1] << " ";
        }
    }

    return 0;
}
